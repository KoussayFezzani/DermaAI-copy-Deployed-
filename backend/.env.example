# DermaAI Backend Environment Configuration
# Copy this file to .env or update values as needed

# MongoDB Connection String (defaults to local MongoDB if not set)
MONGO_URI=mongodb://localhost:27017/skin_lesion_db

# JWT Secret Key for authenticating users
JWT_SECRET_KEY=dermaai-secure-jwt-secret-key-prod-2026

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Optional: SMTP Configuration for password resets
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
